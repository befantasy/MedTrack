# ==========================================
# MedTrack-Onco 环境变量配置
# ==========================================

# 0. 服务端口 (宿主机访问端口，默认 6688)
PORT=6688

# 1. 数据库配置
POSTGRES_USER=meduser
POSTGRES_PASSWORD=med_secure_password_2026
POSTGRES_DB=medtrack_db
DATABASE_URL=postgresql://meduser:med_secure_password_2026@med-postgres:5432/medtrack_db

# 2. JWT 登录鉴权密钥 (生产环境务必替换为随机强密钥)
JWT_SECRET=super-secret-jwt-key-replace-with-random-string-in-production

# 3. 超级管理员默认账号密码：系统预设为 admin / admin，首次登录后可在前端控制台直接自行修改

# 4. 多模态视觉大模型配置 (兼容 OpenAI 协议接口)
# 支持 Google Gemini 2.0 Flash / 阿里通义千问 Qwen2.5-VL / OpenAI GPT-4o / DeepSeek / 本地 Ollama
AI_API_KEY=your_multimodal_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash

# 如果使用阿里通义千问 Qwen-VL，可使用以下配置：
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-vl-max

# 如果使用 OpenAI GPT-4o：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
